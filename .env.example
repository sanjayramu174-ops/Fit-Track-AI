# Copy this file to .env and fill in your own values.
# Never commit your real .env — it contains secrets.

# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────
# Local MongoDB example:  mongodb://127.0.0.1:27017/fittrack
# Atlas example:         mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/fittrack
MONGO_URI=

# ── Auth ──────────────────────────────────────────────────
# Generate a long random string, e.g.:
#   PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Seeded admin account (optional) ───────────────────────
# If both are set, the app creates this admin on first start.
ADMIN_NAME=FitTrack Admin
ADMIN_EMAIL=admin@fittrack.com
ADMIN_PASSWORD=Admin@123

# ── Payments ──────────────────────────────────────────────
# Only "mock" is supported (no real gateway is integrated).
PAYMENT_MODE=mock

# ── AI fitness coach (optional) ───────────────────────────
# Without a key the coach falls back to an honest rule-based plan.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Optional override (e.g. a proxy). Defaults to the official endpoint.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
