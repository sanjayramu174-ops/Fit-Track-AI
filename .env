# Local development configuration.
# This file is git-ignored. Use .env.example as the template and
# replace the placeholder secrets below with your own values.

PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/fittrack

JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_EXPIRES_IN=7d

ADMIN_NAME=FitTrack Admin
ADMIN_EMAIL=admin@fittrack.com
ADMIN_PASSWORD=Admin@123

PAYMENT_MODE=mock

# Leave empty to use the rule-based coach, or paste your own key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
